[Unit]
Description=time-ledger-store — an account of what the operator did, when and where
After=network.target

# A systemd user unit: install it to ~/.config/systemd/user/ and the binary to
# ~/bin. %h is the user's home directory, so nothing here names a user.
[Service]
Type=simple
ExecStart=%h/bin/time-ledger-store

# Loopback, deliberately. What the operator did is private and the service has no auth
# of its own; put a front door that adds it in front.
Environment=TIME_LEDGER_STORE_ADDR=127.0.0.1:8343

WorkingDirectory=%h
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
