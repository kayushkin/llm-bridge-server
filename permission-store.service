[Unit]
Description=permission-store — canonical rule engine for tool-call gating
After=network.target

[Service]
Type=simple
ExecStart=/home/kayushkincom/bin/permission-store --port 8304
Environment=HOME=/home/kayushkincom
Environment=PATH=/home/kayushkincom/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/home/kayushkincom/repos/permission-store
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
